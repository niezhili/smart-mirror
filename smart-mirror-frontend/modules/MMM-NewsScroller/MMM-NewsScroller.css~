.news-scroller {
  width: 100%;
  max-width: 300px;
  margin: 0 auto;
}

.news-item {
  padding: 5px 0;
}

.news-title {
  margin-bottom: 5px;
  font-size: 0.6rem;
  line-height: 1.3;

}

.news-source {
  color: #999;
  font-size: 14px;
  color: yellow;
}

.fade-in {
  animation: fadeIn 1s;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
