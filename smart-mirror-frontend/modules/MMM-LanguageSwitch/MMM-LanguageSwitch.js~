Module.register("MMM-LanguageSwitch", {
	// Default module config
	defaults: {
		language: "En-us",
	},

	getStyles() {
		return ["MMM-LanguageSwitch.css"];
	},

	// Override start method
	start: function() {
		// Use the node_helper to get the current language
		this.sendSocketNotification("GET_LANGUAGE");
	},

	// Override getDom method
	getDom: function() {
		var wrapper = document.createElement("div");

		// Create language toggle button
		var langButton = document.createElement("button");
		langButton.innerHTML = this.currentLanguage === "En-us" ? "中文" : "English";
		langButton.className = "language-toggle-btn";
		langButton.addEventListener("click", () => {
			this.toggleLanguage();
		});
		wrapper.appendChild(langButton);

		return wrapper;
	},

	// Add method to toggle language
	toggleLanguage: function() {
		// Toggle between "en" and "cn"
		const newLanguage = this.currentLanguage === "En-us" ? "Zh-cn" : "En-us";

		// Update state through the node_helper
		this.sendSocketNotification("SET_LANGUAGE", newLanguage);

		// Send notification to reload MagicMirror
		this.sendNotification("LANGUAGE", newLanguage);
		this.sendNotification("CONFIG_CHANGED");

		// Update UI
		this.currentLanguage = newLanguage;
		this.updateDom();
	},

	// Socket notification handler
	socketNotificationReceived: function(notification, payload) {
		if (notification === "CURRENT_LANGUAGE") {
			this.currentLanguage = payload;
			this.updateDom();
		}
	}
});
