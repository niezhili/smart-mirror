Module.register("MMM-LanguageSwitch", {
	// Default module config
	defaults: {
		language: "en",
		// other config options
	},

	// Override start method
	start: function() {
		this.currentLanguage = this.config.language || "en";
		Log.info("Starting module: " + this.name);
	},

	// Override getDom method
	getDom: function() {
		var wrapper = document.createElement("div");

		// Create your module's normal content
		var contentDiv = document.createElement("div");
		contentDiv.innerHTML = this.translate("YOUR_CONTENT_KEY");
		wrapper.appendChild(contentDiv);

		// Create language toggle button
		var langButton = document.createElement("button");
		langButton.innerHTML = this.currentLanguage === "en" ? "中文" : "English";
		langButton.className = "language-toggle-btn";
		langButton.addEventListener("click", () => {
			this.toggleLanguage();
		});
		wrapper.appendChild(langButton);

		return wrapper;
	},

	// Add method to toggle language
	toggleLanguage: function() {
		// Toggle between "en" and "cn"
		this.currentLanguage = this.currentLanguage === "en" ? "cn" : "en";

		// Update the config
		this.config.language = this.currentLanguage;

		// Notify other modules of language change
		this.sendNotification("LANGUAGE_CHANGE", this.currentLanguage);

		// Update the module's DOM
		this.updateDom();
	},

	// Handle notifications from other modules
	notificationReceived: function(notification, payload, sender) {
		if (notification === "LANGUAGE_CHANGE" && sender !== this) {
			this.currentLanguage = payload;
			this.updateDom();
		}
	}
});
